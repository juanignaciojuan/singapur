# Required: LTA DataMall account key (never expose this in frontend code)
LTA_ACCOUNT_KEY=your_lta_account_key_here

# Required: Mapbox public token used by the frontend map initialization.
# Kept in backend config to centralize deployment settings.
MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# Optional server settings
PORT=3000
CACHE_TTL_MS=15000
